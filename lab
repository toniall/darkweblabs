# ci — everything that runs without Docker: repo consistency, every engine's
# offline self-test, and every Docker-free lab check. This is what CI runs on
# each commit and what you can run locally before you push; it exits non-zero if
# anything fails, so a drifted check or a broken engine fails the build instead
# of surfacing later as a reader hitting a wall.
cmd_ci() {
  printf '\n  CI  (lab %s)\n\n' "$LAB_VERSION"
  local fail=0 s id e a

  echo "  repo consistency"
  if cmd_selftest >/dev/null 2>&1; then echo "  PASS  selftest"
  else echo "  FAIL  selftest  (run ./lab selftest to see what drifted)"; fail=$((fail+1)); fi

  echo; echo "  engine self-tests (offline)"
  for e in crawl dedup market leak link detect capstone; do
    if "$LAB_ROOT/lab" "$e" selftest >/dev/null 2>&1; then echo "  PASS  $e selftest"
    else echo "  FAIL  $e selftest"; fail=$((fail+1)); fi
  done
  for a in range-content/seed range-scorer/scorer correlate/correlate \
           i2p-netdb/eclipse hyphanet-routing/routing \
           ransomchat/seed ransomchat/analyze report-viz/report; do
    if python3 "$LAB_ROOT/labs/artifacts/$a.py" --selftest >/dev/null 2>&1; then echo "  PASS  ${a##*/} --selftest"
    else echo "  FAIL  ${a##*/} --selftest"; fail=$((fail+1)); fi
  done
  if python3 "$LAB_ROOT/images/ransomchat/session.py" --selftest >/dev/null 2>&1; then
    echo "  PASS  ransomchat/session --selftest"
  else echo "  FAIL  ransomchat/session --selftest"; fail=$((fail+1)); fi
  for a in ransomwatch/seed ransomwatch/monitor ransomwatch/sites agora/seed agora/slice; do
    if python3 "$LAB_ROOT/labs/datasets/$a.py" --selftest >/dev/null 2>&1; then echo "  PASS  datasets/${a} --selftest"
    else echo "  FAIL  datasets/${a} --selftest"; fail=$((fail+1)); fi
  done

  echo; echo "  offline checks (no Docker)"
  for s in "$LAB_ROOT"/labs/checks/*.sh; do
    # _lib.sh and friends are sourced by the checks, not run as one
    case "$(basename "$s")" in _*) continue;; esac
    # skip anything that talks to Docker directly, or delegates to another check
    # script (the Ch5 synthesis checks re-run the Docker-backed 2.x/3.x checks).
    # Sourcing _lib.sh counts as talking to Docker: dex_has runs docker exec, and
    # a converted check may no longer contain the literal string "docker ".
    grep -qE 'docker |dex_has|_lib\.sh|[0-9]\.sh' "$s" && continue
    id="$(basename "$s" .sh)"
    if bash "$s" >/dev/null 2>&1; then echo "  PASS  check $id"
    else echo "  FAIL  check $id"; fail=$((fail+1)); fi
  done

  if [ -f "$LAB_ROOT/labs/booktest.py" ]; then
    echo; echo "  book integrity"
    if python3 "$LAB_ROOT/labs/booktest.py" >/dev/null 2>&1; then echo "  PASS  booktest"
    else echo "  FAIL  booktest"; fail=$((fail+1)); fi
  fi

  printf '\n'
  if [ "$fail" -eq 0 ]; then echo "  result   everything offline is green"; return 0; fi
  echo "  result   $fail failing"; return 1
}

# booktest — test the manuscript itself: structure, cross-references, figures,
# command coverage, prose hygiene, accessibility (alt text), and rendering.
# Offline and stdlib-only; the rendering check runs only when Playwright is
# present. The book's counterpart to `./lab ci` (which tests the lab code); it
# also runs inside `./lab ci`.
cmd_booktest() {
  if [ ! -f "$LAB_ROOT/labs/booktest.py" ]; then
    printf '\n  BOOK TEST\n\n  skipped: this edition carries the labs, not the manuscript\n\n'
