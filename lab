#!/usr/bin/env bash
# Unlock the Secrets of the DARK WEB, Volume 2 | Antonio Brandao, Author | August 2026
#
# lab — companion CLI for Unlock the Secrets of the DARK WEB, Volume 2
#
#   ./lab doctor          preflight: platform, Docker, memory, lab coverage
#   ./lab list            available stacks
#   ./lab up <stack>      start a lab stack
#   ./lab logs [service]  service logs plus recent healthcheck output
#   ./lab down [stack]    stop+remove containers (i2p|hyphanet|range|overlays|base|all; --volumes drops vols)
#   ./lab stop [stack]    stop containers but keep them (./lab up resumes; ./lab down removes)
#   ./lab reset <stack>   discard scratch state, keep evidence
#   ./lab check <id>      grade a lab against its expected result
#   ./lab range <cmd>     simulated darknet range: list|truth|score|flap|fetch|compare
#   ./lab crawl <cmd>     run the Chapter 9 crawler (selftest|range|score [--naive])
#   ./lab dedup <cmd>     run the Chapter 10 mirror/clone detector (selftest|run|score [--naive])
#   ./lab market <cmd>    run the Chapter 11 market extractor (selftest|store|extract|defenses|graph|score)
#   ./lab leak <cmd>      run the Chapter 12 leak/negotiation extractor (selftest|store|extract|lifecycle|reposts|negotiate|correlate|score)
#   ./lab link <cmd>      run the Chapter 13 persona-linkage engine (selftest|ledger|hard|style|behavior|fuse|score)
#   ./lab detect <cmd>    run the Chapter 14 detection engine (selftest|watchlist|feed|classify|score|correlate|monitor|grade)
#   ./lab capstone <cmd>  run the Chapter 15 capstone report (selftest|evidence|claims|report|grade)
#   ./lab report [all]    build the visual intelligence suite into intel/, mounted read-only in the workstation
#   ./lab open            print the desktop URL
#   ./lab creds           print generated desktop credentials
#
set -uo pipefail

# Recursion guard. A stray self-invocation anywhere in this script would
# otherwise spawn shells until bash complains about SHLVL, with no clue as to
# where it started.
LAB_DEPTH="$(( ${LAB_DEPTH:-0} + 1 ))"
export LAB_DEPTH
if [ "$LAB_DEPTH" -gt 3 ]; then
  printf 'lab: refusing to run %s levels deep — this is a bug in the script.\n' \
    "$LAB_DEPTH" >&2
  printf 'lab: report it, and run the docker compose commands directly meanwhile.\n' >&2
  exit 1
fi

# Bump when any file in the repo changes. `lab doctor` compares this against
# what each file expects, so a half-copied repo says so instead of behaving
# strangely.
LAB_VERSION="5.1.3"

LAB_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
EVIDENCE_DIR="${LAB_EVIDENCE:-$HOME/evidence}"
COMPOSE_FILE="$LAB_ROOT/compose.yml"

# ── output ────────────────────────────────────────────────────────────────────

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  C_DIM=$'\033[2m'; C_OK=$'\033[32m'; C_WARN=$'\033[33m'
  C_BAD=$'\033[31m'; C_HEAD=$'\033[1;35m'; C_OFF=$'\033[0m'
else
  C_DIM=''; C_OK=''; C_WARN=''; C_BAD=''; C_HEAD=''; C_OFF=''
fi

say()   { printf '  %-16s %s\n' "$1" "$2"; }
ok()    { printf '  %-16s %s%s%s\n' "$1" "$C_OK" "$2" "$C_OFF"; }
warn()  { printf '  %-16s %s%s%s\n' "$1" "$C_WARN" "$2" "$C_OFF"; }
bad()   { printf '  %-16s %s%s%s\n' "$1" "$C_BAD" "$2" "$C_OFF"; }
head_() { printf '\n%s%s%s\n\n' "$C_HEAD" "$1" "$C_OFF"; }
die()   { printf '%serror:%s %s\n' "$C_BAD" "$C_OFF" "$1" >&2; exit 1; }

have() { command -v "$1" >/dev/null 2>&1; }

# ── doctor ────────────────────────────────────────────────────────────────────

cmd_doctor() {
  head_ "DARKWEB LAB — preflight"

  say "lab version" "$LAB_VERSION"

  local warnings=0 blockers=0

  # --- platform -------------------------------------------------------------
  local os arch kernel host_kind="native linux"
  os="$(uname -s)"; arch="$(uname -m)"; kernel="$(uname -r)"

  case "$os" in
    Linux)
      if grep -qiE 'microsoft|wsl' /proc/version 2>/dev/null; then
        host_kind="WSL2 (${WSL_DISTRO_NAME:-unknown distro})"
      fi
      ;;
    Darwin) host_kind="macOS" ;;
    *)      host_kind="$os" ;;
  esac

  say  "platform" "$host_kind / $arch"
  say  "kernel"   "$kernel"

  case "$arch" in
    x86_64|amd64)  ok   "architecture" "amd64 — all images native" ;;
    aarch64|arm64) warn "architecture" "arm64 — Tor Browser from the alpha channel"
                   printf '                   Only the 16.0 alpha series ships linux-aarch64.\n'
                   printf '                   Override with LAB_TB_VERSION_ARM if that changes.\n'
                   warnings=$((warnings+1)) ;;
    *)             warn "architecture" "$arch — untested"
                   warnings=$((warnings+1)) ;;
  esac

  # --- docker ---------------------------------------------------------------
  local dver="" cver="" rootless="no"
  if have docker; then
    dver="$(docker version --format '{{.Server.Version}}' 2>/dev/null)"
    if [ -z "$dver" ]; then
      bad "docker" "installed, but the daemon isn't reachable"
      blockers=$((blockers+1))
    else
      docker info -f '{{join .SecurityOptions ","}}' 2>/dev/null \
        | grep -q rootless && rootless="yes"
      local major="${dver%%.*}"
      if [ "${major:-0}" -ge 24 ] 2>/dev/null; then
        ok "docker" "$dver  (rootless: $rootless)"
      else
        warn "docker" "$dver — 24 or newer recommended"
        warnings=$((warnings+1))
      fi
    fi
  else
    bad "docker" "not installed — see Lab 1.0 Step 6"
    blockers=$((blockers+1))
  fi

  if docker compose version >/dev/null 2>&1; then
    cver="$(docker compose version --short 2>/dev/null)"
    ok "compose" "v$cver"
  elif have docker-compose; then
    bad "compose" "v1 detected — this book needs Compose v2"
    blockers=$((blockers+1))
  else
    bad "compose" "not found"
    blockers=$((blockers+1))
  fi

  # --- memory ---------------------------------------------------------------
  local mem_gb=0
  if [ -r /proc/meminfo ]; then
    mem_gb=$(( $(awk '/MemTotal/{print $2}' /proc/meminfo) / 1024 / 1024 ))
  elif have sysctl; then
    mem_gb=$(( $(sysctl -n hw.memsize 2>/dev/null || echo 0) / 1024 / 1024 / 1024 ))
  fi

  if   [ "$mem_gb" -ge 16 ]; then ok   "memory" "${mem_gb} GB — every lab"
  elif [ "$mem_gb" -ge 8  ]; then warn "memory" "${mem_gb} GB — LLM labs need 16 GB"
                                  warnings=$((warnings+1))
  elif [ "$mem_gb" -ge 4  ]; then warn "memory" "${mem_gb} GB — Parts I–II only"
                                  warnings=$((warnings+1))
  else                            bad  "memory" "${mem_gb} GB — below the 4 GB floor"
                                  blockers=$((blockers+1))
  fi

  # --- disk -----------------------------------------------------------------
  local disk_gb
  disk_gb="$(df -BG --output=avail . 2>/dev/null | tail -1 | tr -dc '0-9')"
  disk_gb="${disk_gb:-0}"
  if   [ "$disk_gb" -ge 50 ]; then ok   "disk free" "${disk_gb} GB"
  elif [ "$disk_gb" -ge 20 ]; then warn "disk free" "${disk_gb} GB — 50 GB recommended"
                                   warnings=$((warnings+1))
  else                             bad  "disk free" "${disk_gb} GB — not enough"
                                   blockers=$((blockers+1))
  fi

  # --- kernel features ------------------------------------------------------
  local cgroup="unknown"
  if have stat; then
    case "$(stat -fc %T /sys/fs/cgroup 2>/dev/null)" in
      cgroup2fs) cgroup="v2" ;;
      tmpfs)     cgroup="v1" ;;
    esac
  fi
  [ "$cgroup" = "v2" ] && ok "cgroup" "v2" || say "cgroup" "$cgroup"

  [ -e /dev/kvm ] && ok "kvm" "available" || say "kvm" "not present (not required)"

  if have nvidia-smi; then ok "gpu" "nvidia — local LLM can accelerate"
  else                     say "gpu" "none — local LLM runs on CPU"; fi

  # --- repository location --------------------------------------------------
  local here; here="$(pwd -P)"
  case "$here" in
    /mnt/[a-z]/*)
      bad "repo location" "$here"
      printf '                   %sWindows drive over 9P — builds will crawl.%s\n' \
             "$C_BAD" "$C_OFF"
      printf '                   Move it under your Linux home. See Chapter 1 Step 7.\n'
      blockers=$((blockers+1)) ;;
    *) ok "repo location" "$here" ;;
  esac

  # --- registry reachability ------------------------------------------------
  # A tiny image can succeed while larger blob fetches fail, so check which
  # address family the resolver hands out rather than trusting one pull.
  # What matters is whether an IPv6 socket can be opened at all. If it can,
  # Docker's Go runtime will try AAAA addresses even when nothing is routable.
  local v6_addrs=0
  if have ip; then
    v6_addrs="$(ip -6 addr show scope global 2>/dev/null | grep -c 'inet6')" || v6_addrs=0
  fi
  v6_addrs="${v6_addrs//[!0-9]/}"; v6_addrs="${v6_addrs:-0}"
  if [ ! -e /proc/net/if_inet6 ]; then
    ok "ipv6 stack" "absent — Docker will use IPv4 only"
  elif [ "$v6_addrs" -eq 0 ]; then
    warn "ipv6 stack" "loaded but unrouted — pulls may fail partway"
    printf '                   Docker can open IPv6 sockets, so it will try them.\n'
    printf '                   Fix with: ./lab fix-ipv6\n'
    warnings=$((warnings+1))
  else
    ok "ipv6 stack" "$v6_addrs global address(es)"
  fi

  # Docker Hub is only needed to fetch the base images the lab images are built
  # FROM. Once those are on disk, the lab runs offline — so an unreachable
  # registry is a blocker only if the bases are missing too.
  if have docker && [ -n "$dver" ]; then
    local bases="debian:bookworm-slim nginx:1.27-alpine kasmweb/core-ubuntu-noble:1.16.0"
    local missing=""
    for b in $bases; do
      docker image inspect "$b" >/dev/null 2>&1 || missing="$missing $b"
    done

    if [ -z "$missing" ]; then
      ok "base images" "all present — the registry is not needed"
    elif timeout 40 docker pull -q alpine:3.20 >/dev/null 2>&1; then
      ok "registry" "reachable — missing bases will be fetched"
    else
      bad "registry" "unreachable, and base images are missing"
      for b in $missing; do
        printf '                   missing: %s\n' "$b"
      done
      printf '                   Every Dockerfile starts FROM one of these.\n'
      printf '                   Try: ./lab pin-registry     (forces IPv4 for Docker)\n'
      printf '                   Or import offline: ./lab load-images\n'
      blockers=$((blockers+1))
    fi
  fi

  # --- lab coverage ---------------------------------------------------------
  head_ "Lab coverage"

  local netfilter="yes"
  if [ "$os" = "Darwin" ]; then netfilter="no"
  elif docker info 2>/dev/null | grep -qi 'Operating System: Docker Desktop'; then
    netfilter="no"
  fi

  if [ "$netfilter" = "yes" ]; then
    ok "Lab 2.4" "native netfilter — runs as written"
  else
    warn "Lab 2.4" "Docker Desktop — host firewall lab is degraded"
    printf '                   Run it on Linux or the VPS to see the real behaviour.\n'
    warnings=$((warnings+1))
  fi

  [ "$mem_gb" -ge 16 ] \
    && ok   "Ch. 12 LLM" "16 GB+ — grounded simulation available" \
    || warn "Ch. 12 LLM" "replay mode only below 16 GB"

  [ "$mem_gb" -ge 8 ] \
    && ok   "Parts III-IV" "8 GB+ — collection stacks will run" \
    || warn "Parts III-IV" "use a VPS for continuous collection"

  # --- report ---------------------------------------------------------------
  mkdir -p "$EVIDENCE_DIR"
  cat > "$EVIDENCE_DIR/preflight.json" <<JSON
{
  "generated":    "$(date -u +%Y-%m-%dT%H:%M:%SZ)",
  "platform":     "$host_kind",
  "architecture": "$arch",
  "kernel":       "$kernel",
  "docker":       "${dver:-null}",
  "compose":      "${cver:-null}",
  "rootless":     "$rootless",
  "memory_gb":    $mem_gb,
  "disk_free_gb": $disk_gb,
  "cgroup":       "$cgroup",
  "repo_path":    "$here",
  "netfilter":    "$netfilter",
  "warnings":     $warnings,
  "blockers":     $blockers
}
JSON

  head_ "Result"
  if   [ "$blockers" -gt 0 ]; then
    bad  "status" "$blockers blocker(s), $warnings warning(s) — fix before Lab 1.1"
  elif [ "$warnings" -gt 0 ]; then
    warn "status" "ready, with $warnings warning(s)"
  else
    ok   "status" "ready"
  fi
  printf '  %-16s %s\n\n' "report" "$EVIDENCE_DIR/preflight.json"

  [ "$blockers" -gt 0 ] && return 1 || return 0
}

# ── compose wrappers ──────────────────────────────────────────────────────────

ensure_creds() {
  local envf="$LAB_ROOT/.env"

  # The username is a setting, not a secret — keep it in .env so compose and
  # `lab creds` cannot disagree about it.
  grep -q '^LAB_VNC_USER=' "$envf" 2>/dev/null \
    || printf 'LAB_VNC_USER=%s\n' "${LAB_VNC_USER:-darkweb}" >> "$envf"

  # Tor control-port password, shared with the workstation so Tor Browser and
  # OnionShare drive the gateway's tor instead of starting a second one. Checked
  # independently of the desktop password below, so an existing .env from an
  # earlier version picks it up on the next `up`. Alphanumeric only — it is
  # hashed into the gateway's torrc and quoted into the browser's auth, and
  # keeping it free of shell/JSON metacharacters removes an escaping hazard.
  if ! grep -q '^LAB_CONTROL_PW=' "$envf" 2>/dev/null; then
    local cpw
    if have openssl; then cpw="$(openssl rand -base64 24 | tr -d '/+=' | cut -c1-24)"
    else cpw="$(head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n' | cut -c1-24)"; fi
    printf 'LAB_CONTROL_PW=%s\n' "$cpw" >> "$envf"
    chmod 600 "$envf"
  fi

  grep -q '^LAB_VNC_PW=' "$envf" 2>/dev/null && { chmod 600 "$envf"; return 0; }

  local pw
  if have openssl; then pw="$(openssl rand -base64 18 | tr -d '/+=' | cut -c1-20)"
  else pw="$(head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n' | cut -c1-20)"; fi

  printf 'LAB_VNC_PW=%s\n' "$pw" >> "$envf"
  chmod 600 "$envf"
  printf '  %-16s %s\n' "credentials" "generated — ./lab creds"
}

check_contexts() {
  local missing=""
  for f in images/gateway/Dockerfile images/gateway/torrc \
           images/gateway/entrypoint.sh images/gateway/rules.sh \
           images/workstation/Dockerfile images/workstation/entrypoint.sh \
           images/workstation/netsetup.sh images/workstation/xstartup \
           images/workstation/novnc/darkweb-clipboard.js \
           images/workstation/tor-browser-launch.sh \
           images/workstation/onionshare-fix.py \
           images/workstation/add-onion-key.sh \
           images/workstation/rebrand.py; do
    [ -f "$LAB_ROOT/$f" ] || missing="$missing $f"
  done
  ls "$LAB_ROOT"/images/workstation/desktop/*.desktop >/dev/null 2>&1 \
    || missing="$missing images/workstation/desktop/*.desktop"
  [ -z "$missing" ] && return 0

  printf '%serror:%s missing build files\n\n' "$C_BAD" "$C_OFF" >&2
  for f in $missing; do printf '  %s\n' "$f" >&2; done
  cat >&2 <<'HINT'

Expected layout:

  darkweblabs/
  ├── lab
  ├── compose.yml
  ├── images/
  │   ├── gateway/      Dockerfile, torrc, entrypoint.sh, rules.sh
  │   └── workstation/  Dockerfile, entrypoint.sh, netsetup.sh, xstartup, desktop/
  ├── labs/checks/
  └── site/

HINT
  exit 1
}

