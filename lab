need_compose() {
  [ -f "$COMPOSE_FILE" ] || die "no compose.yml in $LAB_ROOT"
  docker compose version >/dev/null 2>&1 || die "Docker Compose v2 not available"
  check_contexts
  ensure_creds
  load_env
}

# Compose reads .env inconsistently depending on version and working directory,
# so export the values into our own environment instead. Environment variables
# always win over .env, and this works from any directory.
load_env() {
  local envf="$LAB_ROOT/.env"
  [ -f "$envf" ] || return 0
  set -a
  # shellcheck disable=SC1090
  . "$envf"
  set +a
}

dc() {
  docker compose --env-file "$LAB_ROOT/.env" -f "$COMPOSE_FILE" "$@"
}


# Docker Hub publishes AAAA records. WSL2 usually has no working IPv6 route, so
# pulls fail partway with:
#   dial tcp [2600:...]:443: connect: network is unreachable
#
# Two fixes that look right and are not:
#
#   "ipv6": false in daemon.json — governs container networking, not the
#   daemon's own outbound connections.
#
#   /etc/gai.conf precedence — glibc only. dockerd is Go, and Go has its own
#   resolver that reads /etc/resolv.conf and ignores gai.conf entirely.
#
# What works: make IPv6 absent rather than merely unconfigured. sysctl
# disable_ipv6 removes addresses but leaves the stack, so socket(AF_INET6) still
# succeeds, Go concludes IPv6 works, and dials an unreachable address. Disabling
# it in the kernel makes that socket call fail, and Go then filters AAAA records
# out before dialing.
cmd_fix_ipv6() {
  head_ "Making IPv6 absent so Docker stops dialing it"

  local is_wsl=no
  grep -qiE 'microsoft|wsl' /proc/version 2>/dev/null && is_wsl=yes

  if [ "$is_wsl" = yes ]; then
    cat <<'WSLFIX'
  This is WSL2, so the fix goes in Windows, not here.

  1. In PowerShell:

       notepad "$env:USERPROFILE\.wslconfig"

  2. Add this to the [wsl2] section (create it if absent):

       [wsl2]
       kernelCommandLine = ipv6.disable=1

  3. Then, in PowerShell:

       wsl --shutdown

     Wait ten seconds and reopen Ubuntu.

  4. Confirm IPv6 is gone:

       ip -6 addr          # should print nothing
       ./lab doctor

  Why this and not sysctl: sysctl removes IPv6 addresses but leaves the
  stack loaded, so Docker still opens an IPv6 socket, tries the address and
  fails. The kernel flag removes the stack, and Docker then skips IPv6
  addresses entirely.

WSLFIX
    return 0
  fi

  if [ "$(id -u)" -ne 0 ]; then
    echo "  This needs sudo. Re-running..."
    exec sudo "$0" fix-ipv6
  fi

  # Native Linux: a kernel module blacklist has the same effect.
  echo "options ipv6 disable=1" > /etc/modprobe.d/darkweb-noipv6.conf
  echo "  modprobe.d       IPv6 module disabled (takes effect after reboot)"

  mkdir -p /etc/docker
  [ -f /etc/docker/daemon.json ] && \
    cp /etc/docker/daemon.json "/etc/docker/daemon.json.bak.$(date +%s)"
  printf '{\n  "ipv6": false,\n  "dns": ["1.1.1.1", "8.8.8.8"]\n}\n' > /etc/docker/daemon.json
  echo "  daemon.json      written"

  if have systemctl && systemctl is-active --quiet docker; then
    systemctl restart docker && echo "  docker           restarted"
  fi
  echo
  echo "  Reboot, then: ./lab doctor"
}


# Import base images from a tar bundle, for machines that cannot reach a
# registry at all. Create the bundle on a machine that can:
#
#   docker pull debian:bookworm-slim nginx:1.27-alpine \
#              kasmweb/core-ubuntu-noble:1.16.0
#   docker save debian:bookworm-slim nginx:1.27-alpine \
#              kasmweb/core-ubuntu-noble:1.16.0 -o darkweb-bases.tar
cmd_load_images() {
  local tar="${1:-$LAB_ROOT/darkweb-bases.tar}"
  [ -f "$tar" ] || die "no bundle at $tar — see ./lab help for how to build one"
  head_ "Importing base images"
  docker load -i "$tar"
  echo
  echo "  Now run: ./lab doctor"
}


# Docker's daemon is Go, and Go's resolver ignores /etc/gai.conf and does its
# own address selection. On WSL2 that can mean dockerd tries IPv6 addresses no
# other program on the machine is offered — curl works, docker doesn't.
#
# Go checks /etc/hosts before DNS, and when it finds a name there it uses ONLY
# those addresses. Pinning the registry hostnames to their IPv4 addresses
# therefore forces IPv4 for Docker specifically.
#
# This is a workaround, not a cure. Remove the block with ./lab unpin-registry
# once the base images are on disk.
cmd_pin_registry() {
  local hosts=/etc/hosts
  local marker_a="# >>> darkweb lab: force IPv4 for Docker registry"
  local marker_b="# <<< darkweb lab"
  local names="registry-1.docker.io auth.docker.io index.docker.io production.cloudfront.docker.com"

  if [ "$(id -u)" -ne 0 ]; then
    echo "  This needs sudo. Re-running..."
    exec sudo "$0" pin-registry
  fi

  head_ "Pinning Docker registry hostnames to IPv4"

  local block="$marker_a\n"
  local n=0
  for name in $names; do
    local ips
    ips="$(getent ahostsv4 "$name" 2>/dev/null | awk '{print $1}' | sort -u)"
    if [ -z "$ips" ]; then
      warn "$name" "no IPv4 address found"
      continue
    fi
    local ip
    ip="$(echo "$ips" | head -1)"
    block="$block$ip\t$name\n"
    ok "$name" "$ip"
    n=$((n+1))
  done
  block="$block$marker_b"

  [ "$n" -eq 0 ] && die "could not resolve any registry hostname — check DNS"

  cp "$hosts" "$hosts.bak.$(date +%s)"
  sed -i "/^$marker_a\$/,/^$marker_b\$/d" "$hosts"
  printf "%b\n" "$block" >> "$hosts"

  echo
  printf '  %-16s %s\n' "written" "$hosts ($n entries)"
  echo
  echo "  Now run: ./lab up base"
  echo "  Afterwards, undo with: ./lab unpin-registry"
}

cmd_unpin_registry() {
  if [ "$(id -u)" -ne 0 ]; then exec sudo "$0" unpin-registry; fi
  sed -i '/^# >>> darkweb lab: force IPv4 for Docker registry$/,/^# <<< darkweb lab$/d' /etc/hosts
  echo "  removed the pinned registry entries from /etc/hosts"
}

# When a container is unhealthy, the useful information is in two places that
# are awkward to reach: the service log, and the last healthcheck output.
cmd_logs() {
  local svc="${1:-}"
  need_compose
  if [ -z "$svc" ]; then
    dc logs --tail=60
    return 0
  fi

  # Accept either the service name (gateway) or the container name
  # (darkweb-gateway).
  #
  # `docker compose config --services` lists nothing when every service carries
  # a `profiles:` key and no profile is active — which is the case here, and is
  # why this lookup previously reported "no such service" for every name and
  # then printed an empty list of alternatives. Ask with the wildcard profile.
  local services
  services="$(dc --profile '*' config --services 2>/dev/null)"
  [ -n "$services" ] || services="$(dc --profile base config --services 2>/dev/null)"

  if ! printf '%s\n' "$services" | grep -qx "$svc"; then
    local guess="${svc#darkweb-}"
    if printf '%s\n' "$services" | grep -qx "$guess"; then
      svc="$guess"
    else
      printf 'no such service: %s\n\n' "$svc" >&2
      if [ -n "$services" ]; then
        printf 'available:\n' >&2
        printf '%s\n' "$services" | sed 's/^/  /' >&2
      else
        printf 'could not list services — falling back to docker logs:\n' >&2
        printf '  docker logs darkweb-%s\n' "$svc" >&2
      fi
      return 1
    fi
  fi

  head_ "Logs: $svc"
  dc --profile '*' logs --tail=80 "$svc" 2>/dev/null \
    || docker logs --tail=80 "darkweb-$svc" 2>&1

  local cid
  cid="$(dc ps -q "$svc" 2>/dev/null | head -1)"
  [ -z "$cid" ] && return 0

  local state
  state="$(docker inspect -f '{{.State.Health.Status}}' "$cid" 2>/dev/null || echo none)"
  [ "$state" = "none" ] && return 0

  head_ "Health: $state"
  docker inspect -f '{{range .State.Health.Log}}{{.End}}  exit={{.ExitCode}}
{{.Output}}{{end}}' "$cid" 2>/dev/null | tail -20
}

# Files get copied one at a time and then disagree with each other. This checks
# the repo is internally consistent before anything is built or run.
cmd_selftest() {
  head_ "Repo self-test  (lab $LAB_VERSION)"
  local fail=0

  chk() {
    if [ "$2" = ok ]; then ok "$1" "$3"; else bad "$1" "$3"; fail=$((fail+1)); fi
  }

  # --- files present -------------------------------------------------------
  for f in compose.yml \
           images/gateway/Dockerfile images/gateway/torrc \
           images/gateway/entrypoint.sh images/gateway/rules.sh \
           images/workstation/Dockerfile images/workstation/entrypoint.sh \
           images/workstation/netsetup.sh images/workstation/xstartup \
           images/workstation/novnc/darkweb-clipboard.js \
           images/workstation/tor-browser-launch.sh \
           images/workstation/onionshare-fix.py \
           images/workstation/add-onion-key.sh \
           images/workstation/rebrand.py; do
    if [ -f "$LAB_ROOT/$f" ]; then chk "$(basename "$f")" ok "present"
    else chk "$f" no "MISSING"; fi
  done

  # --- content markers, one per fix that has bitten us ---------------------
  local wsd="$LAB_ROOT/images/workstation/Dockerfile"

  grep -q 'apk add --no-cache tor' "$LAB_ROOT/images/gateway/Dockerfile" 2>/dev/null \
    && chk "gateway tor" ok "gateway builds and runs tor itself" \
    || chk "gateway tor" no "stale - the gateway should install tor"

  grep -q 'tcpdump' "$LAB_ROOT/images/gateway/Dockerfile" 2>/dev/null \
    && chk "gateway tcpdump" ok "gateway can capture its own uplink (Ch2 labs + check 5.1)" \
    || chk "gateway tcpdump" no "stale - the Ch2 tcpdump labs and check 5.1 will fail"

  grep -q 'chpasswd' "$wsd" 2>/dev/null \
    && chk "workstation sudo pw" ok "analyst account has a sudo password (Ch2 nmap/proxychains installs)" \
    || chk "workstation sudo pw" no "stale - sudo will prompt for a password that was never set"

  grep -q 'SessionStore' "$LAB_ROOT/images/ransomchat/app.py" 2>/dev/null \
    && chk "ransomchat session" ok "the chat pins group, anchor and deadline server-side (Lab 12.8)" \
    || chk "ransomchat session" no "stale - the operator will re-anchor and re-greet mid-negotiation"

  # booktest tests the MANUSCRIPT, which does not ship in the public repository.
  # Its absence is the expected state there, not a fault.
  [ -f "$LAB_ROOT/labs/booktest.py" ] \
    && chk "booktest" ok "the manuscript test suite is present (./lab booktest, also runs in ci)" \
    || chk "booktest" ok "not in this edition — it carries the labs, not the manuscript"

  grep -q 'build: ./images/gateway' "$LAB_ROOT/compose.yml" 2>/dev/null \
    && chk "gateway image" ok "our own dual-homed gateway, not a stock one" \
    || chk "gateway image" no "stale - expected a built gateway image"

  grep -q 'TransPort' "$LAB_ROOT/images/gateway/torrc" 2>/dev/null \
    && chk "torrc" ok "transparent proxy + DNS ports declared" \
    || chk "torrc" no "stale - transparent proxying will not work"

  grep -qE '^[[:space:]]*HiddenServiceDir' "$LAB_ROOT/images/gateway/torrc" 2>/dev/null \
    && chk "torrc services" no "a HiddenServiceDir with no port stops tor starting" \
    || chk "torrc services" ok "no orphaned HiddenServiceDir"

  # The redirect now happens in PREROUTING, on traffic arriving FROM the
  # workstation, not in OUTPUT. tor's own traffic is never touched, so there is
  # no uid to guess and exempt - the whole simplification of the routed design.
  grep -q 'nat -A PREROUTING' "$LAB_ROOT/images/gateway/rules.sh" 2>/dev/null \
    && chk "redirect model" ok "workstation traffic redirected in PREROUTING" \
    || chk "redirect model" no "stale - expected the routed PREROUTING rules"

  grep -q 'dport 53' "$LAB_ROOT/images/gateway/rules.sh" 2>/dev/null \
    && chk "dns capture" ok "DNS redirected into tor's resolver" \
    || chk "dns capture" no "stale - DNS will bypass tor or fail"

  # Tor Browser and proxychains reach the gateway's SOCKS port explicitly. TCP
  # to the gateway must RETURN before the blanket redirect, or SOCKS is bounced
  # to the TransPort and appears dead while transparent proxying still works.
  grep -q 'p tcp -j RETURN' "$LAB_ROOT/images/gateway/rules.sh" 2>/dev/null \
    && chk "socks reachable" ok "gateway-bound TCP reaches SOCKS, not TransPort" \
    || chk "socks reachable" no "stale - SOCKS traffic would hit the TransPort"

  grep -q 'iptables -t nat -F PREROUTING' "$LAB_ROOT/images/gateway/rules.sh" 2>/dev/null \
    && chk "rules idempotent" ok "cleared before install" \
    || chk "rules idempotent" no "stale - reruns stack duplicate rules"

  # Anything the gateway cannot carry over Tor must be rejected, not forwarded.
  # A ping to the internet timing out here is the design working.
  grep -qE 'FORWARD -j REJECT' "$LAB_ROOT/images/gateway/rules.sh" 2>/dev/null \
    && chk "fail closed" ok "unroutable traffic rejected in FORWARD" \
    || chk "fail closed" no "stale - traffic could leak past the gateway"

  grep -q 'ip_forward' "$LAB_ROOT/compose.yml" 2>/dev/null \
    && chk "forwarding" ok "enabled, so the reject is explicit not a silent drop" \
    || chk "forwarding" no "stale - the gateway cannot route the workstation"

  # The desktop-access bridge must carry inbound noVNC only; a connection the
  # workstation opens there would be a path to the internet around Tor.
  grep -qE 'OUTPUT -o .* -j REJECT' "$LAB_ROOT/images/workstation/netsetup.sh" 2>/dev/null \
    && chk "egress lock" ok "desktop-access interface is inbound only" \
    || chk "egress lock" no "stale - the workstation could leak past the gateway"

  grep -q 'service_healthy' "$LAB_ROOT/compose.yml" 2>/dev/null \
    && chk "start ordering" ok "workstation waits for a healthy gateway" \
    || chk "start ordering" no "stale - workstation may start before tor is ready"

  # 4.6: the workstation's apps drive the gateway's tor over its control port,
  # rather than each launching a second tor.
  grep -q 'ControlPort __GATEWAY_IP__:9051' "$LAB_ROOT/images/gateway/torrc" 2>/dev/null \
    && chk "control port" ok "on the internal interface, reachable by the workstation" \
    || chk "control port" no "stale - the workstation cannot reach the control port"

  grep -q 'tor --hash-password' "$LAB_ROOT/images/gateway/entrypoint.sh" 2>/dev/null \
    && chk "control auth" ok "password hashed into torrc at start" \
    || chk "control auth" no "stale - the control port would not authenticate"

  grep -q '"connection_type": "control_port"' "$LAB_ROOT/images/workstation/entrypoint.sh" 2>/dev/null \
    && chk "onionshare tor" ok "uses the gateway's tor, not a bundled one" \
    || chk "onionshare tor" no "stale - OnionShare would start Tor-over-Tor"

  # 4.7: OnionShare can host through the gateway. It binds 0.0.0.0 (the Whonix
  # marker) and its onion target is repointed at the workstation (the fix), so
  # the gateway's tor can reach the server instead of its own empty loopback.
  grep -q 'anon-ws-base-files/workstation' "$LAB_ROOT/images/workstation/Dockerfile" 2>/dev/null \
    && chk "onionshare bind" ok "server binds on the workstation's interface" \
    || chk "onionshare bind" no "stale - OnionShare would bind loopback only"

  grep -q 'onionshare-fix' "$LAB_ROOT/images/workstation/Dockerfile" 2>/dev/null \
    && chk "onionshare host" ok "onion target repointed to the workstation" \
    || chk "onionshare host" no "stale - a hosted onion would be unreachable"

  # The web root should open the desktop, not a directory listing.
  grep -q 'novnc/index.html' "$LAB_ROOT/images/workstation/Dockerfile" 2>/dev/null \
    && chk "web root" ok "redirects to the desktop client" \
    || chk "web root" no "stale - the root would show a file listing"

  # 4.8: one-click helper to register a keyed onion's key with the gateway.
  grep -q 'add-onion-key' "$LAB_ROOT/images/workstation/Dockerfile" 2>/dev/null \
    && chk "key helper" ok "Add Onion Key shortcut installed" \
    || chk "key helper" no "stale - keyed onions would need the terminal"

  # 4.9: launcher icons rasterized to PNG so xfdesktop renders them without the
  # gdk-pixbuf SVG loader (which the image does not ship).
  grep -q 'rsvg-convert' "$LAB_ROOT/images/workstation/Dockerfile" 2>/dev/null \
    && chk "launcher icons" ok "rasterized to PNG for the desktop" \
    || chk "launcher icons" no "stale - SVG launcher icons would show generic"

  # 4.10: OnionShare chat off the broken gevent-websocket path onto the
  # maintained threading + simple-websocket backend (works on Python 3.12).
  grep -q 'simple-websocket' "$LAB_ROOT/images/workstation/Dockerfile" 2>/dev/null \
    && chk "chat websocket" ok "maintained backend (threading + simple-websocket)" \
    || chk "chat websocket" no "stale - chat socket would upgrade but pump no frames"

  # 4.11: desktop TLS is optional (LAB_TLS); default HTTP on loopback avoids the
  # browser's self-signed-cert warning, LAB_TLS=on restores HTTPS.
  grep -q 'LAB_TLS' "$LAB_ROOT/images/workstation/entrypoint.sh" 2>/dev/null \
    && chk "desktop tls" ok "optional (LAB_TLS); HTTP on loopback by default" \
    || chk "desktop tls" no "stale - expected the LAB_TLS switch"

  # 4.8: Tor Browser channel is arch-aware (stable on x86_64, alpha on arm64).
  grep -q 'TB_VERSION_X86' "$LAB_ROOT/images/workstation/Dockerfile" 2>/dev/null \
    && chk "tor browser" ok "stable on x86_64, alpha on arm64 (only ARM build)" \
    || chk "tor browser" no "stale - expected the arch-aware Tor Browser pin"

  # 5.1.4: check scripts must not name an image tag compose no longer builds.
  # 1.5 graded against :4.11 for a whole release while compose built :5.0, and
  # nothing here noticed. Compare what the checks name against what compose has.
  local ctag btags stale_tags=""
  btags="$(grep -oE 'image: darkweb-lab-[a-z]+:[0-9A-Za-z._-]+' "$LAB_ROOT/compose.yml" \
           | sed 's/.*://' | sort -u)"
  for ctag in $(grep -rhoE 'darkweb-lab-[a-z]+:[0-9A-Za-z._-]+' "$LAB_ROOT/labs/checks" 2>/dev/null \
                | sed 's/.*://' | sort -u); do
    printf '%s\n' "$btags" | grep -qx "$ctag" || stale_tags="$stale_tags $ctag"
  done
  [ -z "$stale_tags" ] \
    && chk "check image tags" ok "every tag the checks name is built by compose" \
    || chk "check image tags" no "stale -$stale_tags not built by compose.yml"

  # 5.2.2: the portal bind-mounts site/, and an empty directory is a 403 and an
  # unhealthy container on a fresh clone. site/ is not in this repository, so the
  # placeholder is generated by check_site at `./lab up` instead of committed.
  grep -q 'PLACEHOLDER' "$LAB_ROOT/lab" \
    && chk "portal placeholder" ok "generated at ./lab up when site/ is empty" \
    || chk "portal placeholder" no "stale - portal would 403 on a fresh clone"

  # 5.2.2: the README states the Tor Browser versions as fact. It said 15.0.19
  # for a release after compose moved to 15.0.21 — the same drift as ./lab doctor
  # naming a variable nothing read, and the same cost: a reader trusts the prose
  # and pins a version that 404s. Compare the two.
  local tb_x86 tb_arm readme_missing=""
  tb_x86="$(sed -n 's/.*LAB_TB_VERSION_X86:-\([0-9A-Za-z.]*\)}.*/\1/p' "$LAB_ROOT/compose.yml" | head -1)"
  tb_arm="$(sed -n 's/.*LAB_TB_VERSION_ARM:-\([0-9A-Za-z.]*\)}.*/\1/p' "$LAB_ROOT/compose.yml" | head -1)"
  for v in "$tb_x86" "$tb_arm"; do
    [ -n "$v" ] || continue
    grep -q "$v" "$LAB_ROOT/README.md" 2>/dev/null || readme_missing="$readme_missing $v"
  done
  [ -z "$readme_missing" ] \
    && chk "README tor pins" ok "README matches the versions compose builds ($tb_x86 / $tb_arm)" \
    || chk "README tor pins" no "stale - compose builds$readme_missing, README says otherwise"

  # 5.2.1: `docker exec ... | grep -q` under pipefail is a race, not a test. grep
  # exits on the first match, the Docker CLI takes SIGPIPE, and pipefail calls a
  # true assertion failed. Lab 2.7's DROP check (pattern on line one) flaked ~40%
  # of runs on it. Use dex_has from labs/checks/_lib.sh instead. A pipe inside a
  # container-side `sh -c` is fine: that shell has no pipefail.
  # Only a HOST-side pipe is racy. If `sh -c` appears before the pipe, the pipe
  # runs in the container's own shell, which has no pipefail — that is fine.
  local racy
  racy="$(awk '
      /docker exec/ {
        p = match($0, /\|[[:space:]]*grep[[:space:]]+-q/)
        if (p == 0) next
        s = index($0, "sh -c")
        if (s == 0 || s > p) print FILENAME
      }' "$LAB_ROOT"/labs/checks/[0-9]*.sh 2>/dev/null \
      | sort -u | xargs -r -n1 basename | tr '\n' ' ')"
  [ -z "$racy" ] \
    && chk "check pipelines" ok "no docker exec piped into grep -q under pipefail" \
    || chk "check pipelines" no "racy grep -q pipeline in: $racy"

  # 5.2.0: .onion has no DNS answer, so any helper that fetches one must hand the
  # name to Tor. A plain curl here returns an empty body and a sha256 of nothing.
  ! grep -qE 'curl -s --max-time 4[0] "http' "$LAB_ROOT/lab" \
    && chk "range fetch proxy" ok "range helpers fetch .onion through SOCKS" \
    || chk "range fetch proxy" no "stale - a range helper curls .onion with no proxy"

  grep -q 'tigervnc-standalone-server' "$wsd" 2>/dev/null \
    && chk "vnc server" ok "TigerVNC from Ubuntu's repos" \
    || chk "vnc server" no "stale — expected TigerVNC"

  grep -q 'novnc websockify' "$wsd" 2>/dev/null \
    && chk "web client" ok "noVNC — a plain directory we own" \
    || chk "web client" no "stale — expected noVNC"

  # /bin/sh is dash on Ubuntu. Running a bash script as `sh script` ignores the
  # shebang and dies on the first bashism — pipefail, arrays, [[ ]].
  local bad=""
  for f in "$LAB_ROOT"/images/*/*.sh; do
    [ -f "$f" ] || continue
    base="$(basename "$f")"
    head -1 "$f" | grep -q 'bin/bash' || continue
    # The word boundary matters: "COPY x.sh /tmp/x.sh" contains the literal
    # text "sh /tmp/x.sh" and would match a naive pattern.
    grep -qE "(^|[[:space:]])sh[[:space:]]+[^[:space:]]*/$base" \
      "$LAB_ROOT"/images/*/Dockerfile 2>/dev/null && bad="$bad $base"
  done
  [ -z "$bad" ] \
    && chk "shell match" ok "bash scripts invoked with bash" \
    || chk "shell match" no "invoked with sh:$bad — dash will reject bashisms"

  # vncconfig is what bridges X selections to the VNC protocol. Without it the
  # clipboard panel in the browser appears to work and moves nothing.
  grep -q 'vncconfig -nowin' "$LAB_ROOT/images/workstation/xstartup" 2>/dev/null \
    && chk "clipboard" ok "vncconfig bridges the selections" \
    || chk "clipboard" no "stale — copy and paste will not work"

  grep -q 'autocutsel -selection PRIMARY' "$LAB_ROOT/images/workstation/xstartup" 2>/dev/null \
    && chk "selections" ok "PRIMARY bridged; CLIPBOARD left to vncconfig" \
    || chk "selections" no "middle-click and Ctrl+V would disagree"

  grep -q 'ubuntu:noble' "$LAB_ROOT/compose.yml" 2>/dev/null \
    && chk "base image" ok "24.04 LTS, pinned by date" \
    || chk "base image" no "check the base — a devel release ages badly"

  # KasmVNC reads ~/.kasmpasswd. Writing to ~/.vnc/passwd (TigerVNC's path)
  # leaves no user with write permission, and vncserver then prompts
  # interactively — which loops forever with no terminal attached.
  grep -q 'darkweb-clipboard.js' "$LAB_ROOT/images/workstation/Dockerfile" 2>/dev/null \
    && chk "clipboard sync" ok "auto sync injected into noVNC" \
    || chk "clipboard sync" no "panel only — no automatic sync"

  # Injecting the script proves nothing on its own. noVNC's app/ui.js is an ES
  # module that exports the UI singleton without putting it on window, so the
  # script can be present, load correctly, and still be unable to see the
  # connection it needs. Check that the seam is opened.
  grep -q 'window.UI = UI' "$LAB_ROOT/images/workstation/Dockerfile" 2>/dev/null \
    && chk "clipboard reach" ok "UI singleton exposed to the bridge" \
    || chk "clipboard reach" no "bridge cannot reach RFB — sync is dead code"

  grep -q 'AcceptCutText' "$LAB_ROOT/images/workstation/entrypoint.sh" 2>/dev/null \
    && chk "cut text" ok "clipboard enabled on the server" \
    || chk "cut text" no "stale — the server would refuse clipboard traffic"

  # websockify must be the container's main process. Started with --daemon it
  # can fail while the container carries on looking alive and serving nothing.
  grep -q 'exec websockify' "$LAB_ROOT/images/workstation/entrypoint.sh" 2>/dev/null \
    && chk "web bridge" ok "websockify runs in the foreground" \
    || chk "web bridge" no "stale — a failure would go unnoticed"

  # xdpyinfo is in x11-utils, not x11-xserver-utils. Probing with it while the
  # wrong package is installed times out every time, and the exit that follows
  # turns a missing binary into a container crash loop.
  grep -q 'dev/tcp/127.0.0.1' "$LAB_ROOT/images/workstation/entrypoint.sh" 2>/dev/null \
    && chk "readiness probe" ok "TCP check, no extra binary needed" \
    || chk "readiness probe" no "stale — probe depends on a package that may be absent"

  grep -q '< /dev/null' "$LAB_ROOT/images/workstation/entrypoint.sh" 2>/dev/null \
    && chk "no prompts" ok "vncserver stdin closed" \
    || chk "no prompts" no "stale — an interactive prompt would loop silently"

  # Tor Browser starts its own tor unless told not to. Inside an already-torified
  # namespace that produces tor over tor: slower, and worse for anonymity rather
  # than better, because it makes the path unusual.
  # Environment alone is not enough on the 16.0 series: the browser still probes
  # a control port it cannot authenticate to, and reports "Tor exited during
  # startup". The launcher has to be disabled in the profile as well.
  if grep -q 'TOR_SKIP_LAUNCH' \
       "$LAB_ROOT/images/workstation/tor-browser-launch.sh" 2>/dev/null; then
    grep -q 'torlauncher.start_tor' \
      "$LAB_ROOT/images/workstation/tor-browser-launch.sh" 2>/dev/null \
      && chk "tor browser" ok "launcher disabled in the profile too" \
      || chk "tor browser" no "env only — will report 'Tor exited during startup'"
  else
    chk "tor browser" no "stale — would run tor over tor"
  fi

  # KasmVNC inlines its logo as base64 in index.html, vnc.html and the minified
  # CSS. Replacing the PNG files alone changes nothing visible.
  # The control-bar and "Connecting…" logos live as data URIs inside the
  # webpack bundle. Processing only html/css leaves both on screen.
  grep -q 'novnc|logo|brand' "$LAB_ROOT/images/workstation/rebrand.py" 2>/dev/null \
    && chk "rebranding" ok "brand marks replaced, control icons left alone" \
    || chk "rebranding" no "stale — the vendor logo will survive"

  grep -q 'librsvg2-bin' "$LAB_ROOT/images/workstation/Dockerfile" 2>/dev/null \
    && chk "rasteriser" ok "librsvg2-bin present for the icon sizes" \
    || chk "rasteriser" no "PNG icons cannot be regenerated"

  grep -q 'proxy_dns' "$LAB_ROOT/images/workstation/Dockerfile" 2>/dev/null \
    && chk "proxychains" ok "configured with proxy_dns" \
    || chk "proxychains" no "stale — hostnames would resolve outside the tunnel"

  grep -q 'onionshare' "$LAB_ROOT/images/workstation/Dockerfile" 2>/dev/null \
    && chk "onionshare" ok "installed" \
    || chk "onionshare" no "missing"

  grep -q 'packages.mozilla.org' "$LAB_ROOT/images/workstation/Dockerfile" 2>/dev/null \
    && chk "firefox" ok "from Mozilla's repo, not the snap stub" \
    || chk "firefox" no "missing — Ubuntu's package cannot run in a container"

  grep -qx 'USER root' "$wsd" 2>/dev/null \
    && chk "build user" ok "reset to root explicitly" \
    || chk "build user" no "stale — inherits whatever the base left set"

  grep -q 'openssl req -x509' "$wsd" 2>/dev/null \
    && chk "tls cert" ok "generated at build time" \
    || chk "tls cert" no "stale — a committed PEM publishes its private key"

  # Ubuntu 24.04 ships a default account at uid 1000. Creating ours without
  # clearing it first fails with "GID '1000' already exists".
  if grep -q 'useradd' "$wsd" 2>/dev/null; then
    grep -q 'getent passwd' "$wsd" 2>/dev/null \
      && chk "analyst account" ok "uid 1000 cleared before it is claimed" \
      || chk "analyst account" no "stale — will collide with noble's default user"
  else
    chk "analyst account" no "stale — no account created"
  fi

  grep -q 'LAB_VNC_PW' "$LAB_ROOT/lab" 2>/dev/null \
    && chk "lab creds" ok "derived, not cached" \
    || chk "lab creds" no "stale — may print a cached username"

  local ws="images/workstation"
  if [ -f "$LAB_ROOT/$ws/branding/background.png" ]; then
    ok "wallpaper file" "branding/background.png present"
  else
    warn "wallpaper file" "none supplied — desktop keeps the stock image"
  fi

  [ -f "$LAB_ROOT/$ws/branding/logo.svg" ] \
    && ok "logo file" "branding/logo.svg present" \
    || warn "logo file" "none supplied — vendor branding stays"

  echo
  if [ "$fail" -gt 0 ]; then
    bad "result" "$fail file(s) out of date — git pull, then ./lab rebuild"
    return 1
  fi
  ok "result" "repo is consistent"
}

# Branding and other file-copy changes land in cached layers. This forces them.
cmd_rebuild() {
  need_compose
  local stack="${1:-base}"
  head_ "Rebuilding $stack without cache"
  dc --profile "$stack" build --no-cache
  dc --profile "$stack" up -d
  echo
  dc ps
}

cmd_list() {
  need_compose
  head_ "Available stacks"
  dc config --profiles 2>/dev/null \
    | sed 's/^/  /' || echo "  (none defined)"
  echo
}

cmd_up() {
  check_site
  local stack="${1:-base}"
  need_compose
  dc --profile "$stack" up -d || return 1
  echo
  dc ps
  echo
  cmd_open
}

# Stop and remove one overlay stack's containers by name prefix — this catches
# both the compose nodes (darkweb-i2p-*, darkweb-fn-*) AND the transient socat
# console bridge (darkweb-i2p-console / darkweb-fn-console), which is not a compose
# service. With purge, also drop that stack's seed volume and internal network.
# It never touches base containers or the evidence volume.
_down_stack() {
  local stack="$1" purge="${2:-}" prefix="" seedvol="" net=""
  case "$stack" in
    i2p)      prefix="darkweb-i2p-"; seedvol="darkweb_i2p_seed"; net="darkweb_i2pnet" ;;
    hyphanet) prefix="darkweb-fn-";  seedvol="darkweb_fn_seed";  net="darkweb_fnnet"  ;;
    range)    prefix="darkweb-range-"; seedvol="darkweb_range_content"; net="darkweb_rangenet" ;;
    *) return 0 ;;
  esac
  local ids
  ids="$(docker ps -aq --filter "name=${prefix}" 2>/dev/null)"
  if [ -n "$ids" ]; then
    if docker rm -f $ids >/dev/null 2>&1; then
      echo "  ${stack}: stopped and removed $(printf '%s\n' "$ids" | grep -c .) container(s)"
    else
      echo "  ${stack}: could not remove some containers (are they in use?)"
    fi
  else
    echo "  ${stack}: no containers to remove"
  fi
  if [ -n "$purge" ]; then
    docker volume  rm "$seedvol" >/dev/null 2>&1 && echo "  ${stack}: removed seed volume ${seedvol}"
    docker network rm "$net"     >/dev/null 2>&1 && echo "  ${stack}: removed network ${net}"
  fi
}

cmd_down() {
  need_compose
  local target="" purge=""
  for a in "$@"; do
    case "$a" in
      --volumes|-v|--purge) purge=1 ;;
      -*) echo "unknown flag: $a"; return 1 ;;
      *)  [ -z "$target" ] && target="$a" ;;
    esac
  done

  case "${target:-all}" in
    all)
      # everything, containers + networks, volumes kept (evidence is never dropped)
      dc --profile '*' down
      if [ -n "$purge" ]; then echo "  (note: --volumes ignored for 'all' — the evidence volume is never auto-removed; use ./lab down i2p|hyphanet|range --volumes to drop its volume)"; fi
      ;;
    base)
      dc --profile base down
      if [ -n "$purge" ]; then echo "  (note: --volumes ignored for 'base' — evidence is never auto-removed)"; fi
      ;;
    i2p)         _down_stack i2p "$purge" ;;
    hyphanet|fn) _down_stack hyphanet "$purge" ;;
    range)       _down_stack range "$purge" ;;
    overlays)    _down_stack i2p "$purge"; _down_stack hyphanet "$purge" ;;
    *)
      echo "usage: ./lab down [i2p|hyphanet|range|overlays|base|all] [--volumes]"
      echo "  no argument tears down everything (keeps volumes)"
      echo "  --volumes also drops the i2p/hyphanet/range volume (never the evidence volume)"
      return 1 ;;
  esac
}

_stop_stack() {
  local stack="$1" prefix=""
  case "$stack" in
    i2p)      prefix="darkweb-i2p-" ;;
    hyphanet) prefix="darkweb-fn-"  ;;
    range)    prefix="darkweb-range-" ;;
    *) return 0 ;;
  esac
  local ids
  ids="$(docker ps -q --filter "name=${prefix}" 2>/dev/null)"
  if [ -n "$ids" ]; then
    if docker stop $ids >/dev/null 2>&1; then
      echo "  ${stack}: stopped $(printf '%s\n' "$ids" | grep -c .) container(s) — kept; ./lab up ${stack} resumes them"
    else
      echo "  ${stack}: could not stop some containers"
    fi
  else
    echo "  ${stack}: no running containers to stop"
  fi
}

cmd_stop() {
  need_compose
  local target="${1:-all}"
  # stop = pause containers without removing them. Data, volumes, and networks are
  # never touched; ./lab up <stack> restarts them quickly. Use ./lab down to remove.
  case "$target" in
    all)         dc --profile '*' stop ;;
    base)        dc --profile base stop ;;
    i2p)         _stop_stack i2p ;;
    hyphanet|fn) _stop_stack hyphanet ;;
    range)       _stop_stack range ;;
    overlays)    _stop_stack i2p; _stop_stack hyphanet ;;
    *)
      echo "usage: ./lab stop [i2p|hyphanet|range|overlays|base|all]"
      echo "  stops containers without removing them; ./lab up <stack> resumes them fast"
      echo "  no argument stops everything (containers kept; use ./lab down to remove them)"
      return 1 ;;
  esac
}

cmd_reset() {
  local stack="${1:-base}"
  need_compose
  printf 'Resetting %s. Evidence is preserved; scratch state is discarded.\n' "$stack"
  dc --profile "$stack" down
  # scratch volumes only — never the evidence volume
  docker volume ls -q --filter 'name=darkweb_.*scratch' | while read -r v; do
    [ -n "$v" ] && docker volume rm "$v" >/dev/null && echo "  removed $v"
  done
  dc --profile "$stack" up -d
  echo "Done."
}

