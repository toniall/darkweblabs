      echo "  wrote the visual intelligence suite to intel/"
      if docker ps --format '{{.Names}}' 2>/dev/null | grep -q '^darkweb-workstation$'; then
        echo "  the workstation mounts it read-only — open  file:///intel/index.html  in its browser"
