# I2P testnet helpers (Chapter 6). Thin wrappers around the routers' real i2pd
# interfaces — a convenience layer for the chapter. The checks call docker exec
# directly and do NOT depend on this. SCAFFOLD: the console bridge and the
# console-page parsing follow i2pd's web console and may need adjusting to your
# i2pd version; the testnet must be converged (./lab check 6.1) for most of it.
cmd_i2p() {
  local sub="${1:-}"; [ "$#" -gt 0 ] && shift
  local r="${1:-r1}"
  local cname="darkweb-i2p-${r}"
  case "$sub" in
    console)
      # Bridge the router's console (7070) to the host with a throwaway socat
      # container on the internal net; then browse http://127.0.0.1:7070.
      docker rm -f darkweb-i2p-console >/dev/null 2>&1 || true
      if docker run -d --rm --name darkweb-i2p-console \
           --network darkweb_i2pnet -p 127.0.0.1:7070:7070 \
           alpine/socat tcp-listen:7070,fork,reuseaddr "tcp:${cname}:7070" >/dev/null 2>&1; then
        echo "  console for ${cname} -> http://127.0.0.1:7070"
        echo "  (stop it with: docker rm -f darkweb-i2p-console)"
      else
        echo "  couldn't start the console bridge; read it in-container instead:"
        echo "    docker exec ${cname} wget -qO- http://127.0.0.1:7070/"
      fi
      ;;
    netdb)
      # Count files, not a naming assumption. Peers land as
      # netDb/rX/routerInfo-<hash>.dat on this i2pd, and while routerInfo-*.dat
      # does match those, *.dat survives a layout change and is what the
      # healthcheck and Lab 6.1 grade on. One number, one definition.
      docker exec "$cname" sh -c '
        d="${I2P_DATADIR:-/home/i2pd/data}/netDb"
        n=$(find "$d" -type f -name "*.dat" 2>/dev/null | wc -l)
        echo "  known routers   : $n"
        if [ "$n" -eq 0 ]; then
          echo "  note            : zero is normal for the first few minutes."
          echo "                    Still zero after ~5? Check that peers publish a"
          echo "                    reachable address: ./lab i2p console '"'"'"$(hostname)"'"'"'"
        fi
        echo "  floodfills      : ff1, ff2 (floodfill = true in their config)"
      ' 2>/dev/null || echo "  (router ${cname} not up? bring the testnet up: ./lab up i2p)"
      ;;
    tunnels)
      docker exec "$cname" sh -c \
        'wget -qO- "http://127.0.0.1:7070/?page=tunnels" 2>/dev/null | sed "s/<[^>]*>//g" | grep -iE "inbound|outbound|tunnel" | head' \
        2>/dev/null || echo "  (couldn't read tunnels from ${cname}; is the testnet converged?)"
      ;;
    publish|eepsite)
      echo "  scaffold: expose a web server on ${r} via an i2pd [server] tunnel."
      echo "  add a server tunnel to ${cname}'s tunnels.conf, restart it, then read"
      echo "  the destination's .b32 from the console. See Lab 6.4 for the steps."
      ;;
    fetch)
      local b32="${2:-}"
      [ -n "$b32" ] || { echo "usage: ./lab i2p fetch <router> <name.b32.i2p>"; return 1; }
      docker exec "$cname" sh -c \
        "wget -qO- --timeout=30 -e use_proxy=yes -e http_proxy=http://127.0.0.1:4444 'http://$b32' 2>/dev/null | head" \
        || echo "  (fetch failed — leaseSet not found or service down; eepsites flicker)"
      ;;
    *)
      echo "usage: ./lab i2p {console|netdb|tunnels|publish|eepsite|fetch} <router> [arg]"
      echo "  routers: ff1 ff2 r1 r2 r3   (bring the testnet up with ./lab up i2p)"
      return 1
      ;;
  esac
}

# Hyphanet (Fred) testnet helpers (Chapter 7). Thin wrappers over FProxy / FCP /
# docker exec — a convenience layer for the chapter. The checks call docker exec
# directly and do NOT depend on this. SCAFFOLD: insert/fetch/genkey use FCP, which
# is version-sensitive, and the darknet must be settled first (./lab check 7.1).
cmd_fn() {
  local sub="${1:-}"; [ "$#" -gt 0 ] && shift
  local n="${1:-n1}"
  local cname="darkweb-fn-${n}"
  case "$sub" in
    console)
      docker rm -f darkweb-fn-console >/dev/null 2>&1 || true
      if docker run -d --rm --name darkweb-fn-console \
           --network darkweb_fnnet -p 127.0.0.1:8888:8888 \
           alpine/socat tcp-listen:8888,fork,reuseaddr "tcp:${cname}:8888" >/dev/null 2>&1; then
        echo "  FProxy for ${cname} -> http://127.0.0.1:8888"
        echo "  (stop it with: docker rm -f darkweb-fn-console)"
      else
        echo "  couldn't start the FProxy bridge; read it in-container instead:"
        echo "    docker exec ${cname} wget -qO- http://127.0.0.1:8888/"
      fi
      ;;
    peers)
      docker exec "$cname" sh -c \
        'grep -q "opennet.enabled=false" /data/freenet.ini 2>/dev/null && echo "  opennet: DISABLED (darknet)"; ls /data/friend-*.fref 2>/dev/null | wc -l | sed "s/^/  darknet peer refs: /"' \
        2>/dev/null || echo "  (node ${cname} not up? bring it up: ./lab up hyphanet)"
      ;;
    store)
      docker exec "$cname" sh -c \
        'grep -E "storeSize" /data/freenet.ini 2>/dev/null | sed "s/^/  /"; echo "  blocks encrypted; cached/relayed content is not readable by this node"' \
        2>/dev/null || echo "  (node ${cname} not up?)"
      ;;
    insert|fetch|genkey|putsite)
      echo "  scaffold: '${sub}' uses the Freenet Client Protocol (FCP) on ${cname}:9481."
      echo "  FCP is version-sensitive; drive it with an FCP client against the node, or"
      echo "  use FProxy. See Lab 7.2 (insert/fetch) and 7.3 (keys/freesites) for the steps."
      ;;
    *)
      echo "usage: ./lab fn {console|insert|fetch|genkey|putsite|peers|store} <node> [arg]"
      echo "  nodes: n1 n2 n3 n4   (bring the testnet up with ./lab up hyphanet)"
      return 1
      ;;
  esac
}

cmd_range() {
  local sub="${1:-}"; [ "$#" -gt 0 ] && shift
  local art="$LAB_ROOT/labs/artifacts/range-scorer"
  local tor="darkweb-range-tor" ws="darkweb-workstation"
  case "$sub" in
    list)
      local filter="${1:-}" map
      case "$filter" in
        --cross)
          echo "  cross-network references in the range directory:"
          RANGE_MANIFEST="$art/manifest.json" python3 -c "
import json, os
m = json.load(open(os.environ['RANGE_MANIFEST']))
for c in m.get('cross_links', []):
    print('    %-9s -> (%s) %s' % (c['from'], c['network'], c.get('kind', '')))
print('  following these requires the I2P / Hyphanet transports, not Tor')
"
          ;;
        *)
          map="$(docker exec "$tor" cat /content/onions.env 2>/dev/null)" \
            || { echo "  range not up? bring it up: ./lab up range"; return 1; }
          if [ "$filter" = "--directory" ]; then
            echo "  services listed in the range directory (a subset — discovery is incomplete):"
            printf '%s\n' "$map" | grep -E '^(directory|market|market-mirror|forum)=' | sed 's/^/    /'
          else
            echo "  range services (onion addresses are ephemeral — regenerated each bring-up):"
            printf '%s\n' "$map" | sed 's/^/    /'
          fi
          ;;
      esac
      ;;
    truth)
      [ -f "$art/manifest.json" ] || { echo "  no manifest at $art/manifest.json"; return 1; }
      echo "  range ground truth (services, mirror/clone relationships, cross-links):"
      python3 -m json.tool "$art/manifest.json"
      ;;
    score)
      local f="${1:-}"; [ -n "$f" ] || { echo "usage: ./lab range score <crawl-output.json>"; return 1; }
      [ -f "$f" ] || f="$art/$f"
      [ -f "$f" ] || { echo "  no such crawl file: ${1} (also tried $art/)"; return 1; }
      # Bind the answer key to the range that is running, if it is: manifest.json
      # ships addr-* placeholders and the live range mints new onions on every
      # bring-up, so without this a live crawl scores zero against a good crawl.
      # No range up means an archived crawl, which scores against the placeholders
      # exactly as before.
      local livemap
      livemap="$(docker exec "$tor" cat /content/onions.env 2>/dev/null)"
      if [ -n "$livemap" ]; then
        printf '%s\n' "$livemap" | python3 "$art/scorer.py" "$f" --map -
      else
        python3 "$art/scorer.py" "$f"
      fi
      ;;
    seed)
      docker exec "$tor" python3 /opt/seed.py --out /content \
        && echo "  regenerated watermarked content in the range" \
        || { echo "  (range not up? ./lab up range)"; return 1; }
      ;;
    flap)
      local svc="${1:-leak}"
      echo "  range: simulating seizure/rebrand of '${svc}' — dropping its onion key"
      # onions.env is written once, at container start. Without rewriting it here
      # the seized address stays in the file, `./lab range list` reports an onion
      # that no longer exists, and the service looks dead everywhere — which is
      # the opposite of the lesson. The service is alive at a NEW address.
      local newonion
      newonion="$(docker exec "$tor" sh -c '
        svc="$1"; dir="/var/lib/tor/range-${svc}"; hn="${dir}/hostname"; env=/content/onions.env
        [ -d "$dir" ] || { echo "no such range service: ${svc}" >&2; exit 1; }
        rm -rf "$dir"
        mkdir -p "$dir" && chown tor:tor "$dir" && chmod 700 "$dir"
        pkill -HUP tor || kill -HUP 1
        n=0
        while [ ! -s "$hn" ] && [ "$n" -lt 60 ]; do sleep 2; n=$((n+1)); done
        new="pending"; [ -s "$hn" ] && new="$(cat "$hn")"
        tmp="$(mktemp)"
        grep -v "^${svc}=" "$env" > "$tmp" 2>/dev/null
        echo "${svc}=${new}" >> "$tmp"
        cat "$tmp" > "$env"          # in place: /content is a bind mount
        rm -f "$tmp"
        printf "%s" "$new"
      ' _ "$svc" 2>/dev/null)" \
        || { echo "  (range not up? ./lab up range)"; return 1; }
      if [ -z "$newonion" ] || [ "$newonion" = "pending" ]; then
        echo "  range: '${svc}' key dropped, but it has not republished yet — re-check with ./lab range list"
      else
        echo "  range: '${svc}' republished at ${newonion}"
        echo "  a crawler holding the old address now collects nothing; onions.env is updated"
      fi
      ;;
    fetch)
      local svc="${1:-}" path="${2:-/}" onion
      [ -n "$svc" ] || { echo "usage: ./lab range fetch <service> [path]"; return 1; }
      onion="$(docker exec "$tor" sh -c "grep -E '^${svc}=' /content/onions.env | cut -d= -f2" 2>/dev/null)"
      [ -n "$onion" ] && [ "$onion" != "pending" ] || { echo "  no published onion for '${svc}' (try: ./lab range list)"; return 1; }
      echo "  GET http://${onion}${path}  (through the workstation's Tor)"
      # --socks5-hostname, not --socks5: the hostname must be resolved by Tor.
      # A .onion has no DNS answer, so a plain curl here returns nothing at all,
      # which is where the empty-body e3b0c442 hashes came from.
      docker exec "$ws" curl -s --max-time 40 \
        --socks5-hostname "${LAB_SOCKS:-gateway:9050}" "http://${onion}${path}" \
        || echo "  (fetch failed — service down or still publishing)"
      ;;
    compare)
      local a="${1:-market}" b="${2:-market-mirror}" c="${3:-market-clone}" s onion body hash pgp btc
      echo "  comparing content-hash + key material across three addresses:"
      for s in "$a" "$b" "$c"; do
        onion="$(docker exec "$tor" sh -c "grep -E '^${s}=' /content/onions.env | cut -d= -f2" 2>/dev/null)"
        [ -n "$onion" ] || { printf '    %-14s (no onion — ./lab range list)\n' "$s"; continue; }
        body="$(docker exec "$ws" curl -s --max-time 40 \
                --socks5-hostname "${LAB_SOCKS:-gateway:9050}" "http://${onion}/" 2>/dev/null)"
        hash="$(printf '%s' "$body" | sha256sum | cut -c1-12)"
        pgp="$(printf '%s' "$body" | grep -oE '[0-9A-F]{14}' | head -1)"
        btc="$(printf '%s' "$body" | grep -oE 'bc1q[a-z0-9_]+' | head -1)"
        printf '    %-14s hash %s  pgp %s  btc %s\n' "$s" "${hash:-?}" "${pgp:-?}" "${btc:-?}"
      done
      echo "  identical hash at different onions -> mirror; altered pgp/btc -> clone"
      ;;
    *)
      echo "usage: ./lab range {list|truth|score|seed|flap|fetch|compare} [args]"
      echo "  list [--directory|--cross]   published services (or the directory subset / cross-network refs)"
      echo "  truth                        the ground-truth manifest (the answer key)"
      echo "  score <crawl.json>           score a crawl against ground truth (recall/precision/clones)"
      echo "  seed                         regenerate the watermarked content"
      echo "  flap <service>               simulate seizure/rebrand at a new onion   e.g. ./lab range flap leak"
      echo "  fetch <service> [path]       fetch a service through the workstation's Tor"
      echo "  compare <a> <b> <c>          diff content-hash + keys across addresses"
      echo "  (bring the range up first: ./lab up range)"
      return 1
      ;;
  esac
}

cmd_crawl() {
  local sub="${1:-}"; [ "$#" -gt 0 ] && shift
  local art="$LAB_ROOT/labs/artifacts/crawler"
  local tor="darkweb-range-tor" ws="darkweb-workstation"
  case "$sub" in
    selftest)
      # the crawler's brain self-tests offline — no Docker, no Tor required
      local rc=0
      ( cd "$art" && python3 frontier.py --selftest ) || rc=1
      ( cd "$art" && python3 extract.py  --selftest ) || rc=1
      ( cd "$art" && python3 crawl.py    --selftest ) || rc=1
      [ "$rc" -eq 0 ] && echo "  crawler self-tests passed (frontier, extract, crawl+scorer)"
      return "$rc"
      ;;
    range|score)
      local naive="" mode="full engine"
      for a in "$@"; do case "$a" in --naive) naive="--naive"; mode="naive crawl" ;; esac; done
      local map
      map="$(docker exec "$tor" cat /content/onions.env 2>/dev/null)" \
        || { echo "  range not up? bring it up: ./lab up range"; return 1; }
      # scope = every published range host; seed = the directory
      local allow seed
      allow="$(printf '%s\n' "$map" | awk -F= 'NF==2 && $2!="pending"{printf "http://%s/,",$2}')"
      seed="$(printf '%s\n' "$map" | awk -F= '$1=="directory" && $2!="pending"{print "http://"$2"/"}')"
      [ -n "$seed" ] || { echo "  the range directory has no published onion yet (try: ./lab range list)"; return 1; }
      echo "  crawling the range through the workstation's Tor (${mode})..."
      docker exec -e LAB_ALLOW="$allow" -e LAB_SEED="$seed" "$ws" \
        python3 /opt/crawler/crawl_live.py --out /evidence/crawl-output.json $naive \
        || { echo "  crawl failed (is the workstation up, and Tor reaching the range?)"; return 1; }
      if [ "$sub" = "score" ]; then
        echo "  scoring the crawl against the range ground truth (the Lab 8.7 harness):"
        docker exec "$ws" python3 /opt/range-scorer/scorer.py /evidence/crawl-output.json
      else
        echo "  wrote crawl-output.json to the evidence volume; grade it with: ./lab crawl score"
      fi
      ;;
    *)
      echo "usage: ./lab crawl {selftest|range|score} [--naive]"
      echo "  selftest       run the crawler's offline self-tests (frontier, extract, crawl+scorer)"
      echo "  range          run the crawler against the range over Tor; writes crawl-output.json"
      echo "  range --naive  a first crawl with sessions, dedup, and clone detection off"
      echo "  score          crawl the range, then grade the result on the Lab 8.7 harness"
      echo "  (bring the range up first: ./lab up range)"
      return 1
      ;;
  esac
}

