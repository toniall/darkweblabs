Start with:  ./lab doctor
USAGE
}

cmd_update() {
  # Refresh the real-data snapshots from their public GitHub sources and re-stamp the
  # capture date. Ch12/Ch14 draw on the live ransomwatch feed; Ch11's Agora slice is a
  # fixed archive. See the note in each real-data lab for the run/compare/update workflow.
  python3 "$LAB_ROOT/labs/datasets/update.py" "$@"
}

